# Backend API URL (only needed if NOT using Nginx proxy in production)
VITE_API_URL=http://localhost:8000

# Google OAuth - must match the backend GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Mappls (maps)
VITE_MAPPLS_TOKEN=your_mappls_token_here

# Cloudinary (image uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=unsigned_preset
